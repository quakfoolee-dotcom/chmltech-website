d=\"M 407.1852 99.48132 \nL 485.7516 99.48132 \nQ 490.662 99.48132 490.662 97.15284 \nL 490.662 35.44812 \nQ 490.662 33.11964 485.7516 33.11964 \nL 407.1852 33.11964 \nQ 402.2748 33.11964 402.2748 35.44812 \nL 402.2748 97.15284 \nQ 402.2748 99.48132 407.1852 99.48132 \nz\n\" clip-path=\"url(#p6a8a226bb0)\" style=\"fill: #cfe6f3; stroke: #0b6fa4; stroke-linejoin: miter\"/>\n   </g>\n   <g id=\"patch_11\">\n    <path d=\"M 14.3532 206.5914 \nL 92.9196 206.5914 \nQ 97.83 206.5914 97.83 204.26292 \nL 97.83 142.5582 \nQ 97.83 140.22972 92.9196 140.22972 \nL 14.3532 140.22972 \nQ 9.4428 140.22972 9.4428 142.5582 \nL 9.4428 204.26292 \nQ 9.4428 206.5914 14.3532 206.5914 \nz\n\" clip-path=\"url(#p6a8a226bb0)\" style=\"fill: #e4f1d3; stroke: #4d7f12; stroke-linejoin: miter\"/>\n   </g>\n   <g id=\"patch_12\">\n    <path d=\"M 99.54864 173.41056 \nQ 102.98592 173.41056 104.857952 173.41056 \n\" clip-path=\"url(#p6a8a226bb0)\" style=\"fill: none; stroke: #4d7f12; stroke-width: 1.4; stroke-linecap: round\"/>\n    <path d=\"M 101.257952 171.61056 \nL 104.857952 173.41056 \nL 101.257952 175.21056 \nz\n\" clip-path=\"url(#p6a8a226bb0)\" style=\"fill: #4d7f12; stroke: #4d7f12; stroke-width: 1.4; stroke-linecap: round\"/>\n   </g>\n   <g id=\"patch_13\">\n    <path d=\"M 112.5612 206.5914 \nL 191.1276 206.5914 \nQ 196.038 206.5914 196.038 204.26292 \nL 196.038 142.5582 \nQ 196.038 140.22972 191.1276 140.22972 \nL 112.5612 140.22972 \nQ 107.6508 140.22972 107.6508 142.5582 \nL 107.6508 204.26292 \nQ 107.6508 206.5914 112.5612 206.5914 \nz\n\" clip-path=\"url(#p6a8a226bb0)\" style=\"fill: #e4f1d3; stroke: #4d7f12; stroke-linejoin: miter\"/>\n   </g>\n   <g id=\"patch_14\">\n    <path d=\"M 197.75664 173.41056 \nQ 201.19392 173.41056 203.065952 173.41056 \n\" clip-path=\"url(#p6a8a226bb0)\" style=\"fill: none; stroke: #4d7f12; stroke-width: 1.4; stroke-linecap: round\"/>\n    <path d=\"M 199.465952 171.61056 \nL 203.065952 173.41056 \nL 199.465952 175.21056 \nz\n\" clip-path=\"url(#p6a